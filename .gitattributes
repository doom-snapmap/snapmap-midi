# Workflow YAML MUST be LF: a CRLF checkout puts stray \r into `shell: bash` steps,
# breaking `set -euo pipefail`.
*.yml text eol=lf

# Byte fixtures are compared exactly. Never let line-ending translation touch them --
# a CRLF-mangled fixture fails the byte gates for a reason that has nothing to do with
# the code, which is the hardest kind of failure to diagnose.
*.mid binary
tests/fixtures/*.json binary

# Generated package data. `tools/build_sound_palette.py` writes LF on every
# platform; pinning it here too means a contributor with core.autocrlf off
# cannot accidentally commit 943 lines of CRLF as a whole-file diff.
src/snapmap_midi/data/*.json text eol=lf
